# Server Configuration
PORT=5000
NODE_ENV=production

# DATABASE_URL
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require


# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRE=7d
JWT_RESET_EXPIRE=15m

# Network Security (Legacy - applies to all routes - DEPRECATED)
ENABLE_IP_RESTRICTION=false
ALLOWED_IPS=127.0.0.1,::1

# Selective Network Security (Attendance-only restriction)
# Restricts check-in/check-out endpoints to office network only
# Other endpoints (leave requests, profile, reports) remain accessible
ENABLE_SELECTIVE_IP_RESTRICTION=true
ATTENDANCE_ALLOWED_IPS=127.0.0.1,192.168.1.0/24

# Email Configuration (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=E-Attendance System <noreply@attendance.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Attendance Rules
CHECK_IN_START_TIME=09:00
CHECK_IN_END_TIME=09:30
LATE_THRESHOLD_MINUTES=30
HALF_DAY_HOURS=4
FULL_DAY_HOURS=8

# Leave Rules
ANNUAL_PAID_LEAVES=7
